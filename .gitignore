# Example plugins ship their config files so the demos run as-is; they hold no
# secrets. The generated one is a runtime artifact -- leave it out so each
# checkout gets the first-boot experience.
!examples/**/.env
examples/plugin-showcase/generated.yml
/.key/
.plugins
.codegraph
.dev