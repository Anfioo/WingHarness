# 配置能力全示例：env 源（startmust: true，缺少它插件拒绝启动）。
#
# 键是平铺名，值就是等号后面的内容。应用保存时只改对应的那一行，
# 注释、空行、其它键和行尾的 ` # 注释` 都会原样保留。

# 监听地址与端口。ui 里的 {SHOWCASE_HOST} / {SHOWCASE_PORT} 就来自这两项。
SHOWCASE_HOST=127.0.0.1
SHOWCASE_PORT=8123

# 页面标题
SHOWCASE_TITLE=Plugin Showcase

# options 对象写法：取值只允许 auto / light / dark，label 决定下拉显示什么。
SHOWCASE_THEME=auto

# 带 options 的 boolean 是个开关：trueValue 指定哪个 value 代表「开」。
# 这里文件用 1/0，所以写 1 是开、0 是关。
SHOWCASE_PROXY=0
