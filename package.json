{
	"name": "wingharness",
	"private": true,
	"version": "0.0.3",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"release:version": "node scripts/release-version.mjs",
		"themes:fetch": "node scripts/fetch-theme-presets.mjs",
		"tauri": "node scripts/tauri.mjs",
		"tauri:dev": "node scripts/tauri.mjs dev",
		"tauri:build": "tauri build --bundles nsis",
		"tauri:build:ps": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\build.ps1",
		"format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
		"lint": "eslint src/**/*.{ts,tsx} vite.config.ts",
		"lint:fix": "eslint src/**/*.{ts,tsx} vite.config.ts --fix",
		"check": "pnpm format:check && pnpm lint && pnpm build",
		"prepare": "husky"
	},
	"dependencies": {
		"7z-wasm": "1.2.0",
		"@mind-elixir/import-xmind": "1.0.8",
		"@tailwindcss/vite": "^4.2.1",
		"@tauri-apps/api": "^2.12.1",
		"@tauri-apps/plugin-dialog": "^2",
		"@tauri-apps/plugin-global-shortcut": "^2.3.1",
		"@tauri-apps/plugin-opener": "^2",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"ag-psd": "31.0.2",
		"cfb": "1.2.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"codelet": "^0.2.0",
		"dompurify": "3.4.11",
		"exceljs": "4.4.0",
		"fflate": "0.8.3",
		"i18next": "^25.8.18",
		"i18next-browser-languagedetector": "^8.2.1",
		"icojs": "1.0.1",
		"jszip": "3.10.1",
		"lucide-react": "^0.577.0",
		"mammoth": "1.12.0",
		"marked": "18.0.6",
		"mind-elixir": "5.12.2",
		"node-unrar-js": "2.0.2",
		"papaparse": "5.5.4",
		"pdfjs-dist": "6.1.200",
		"postal-mime": "3.0.0",
		"pptxviewjs": "1.1.9",
		"radix-ui": "^1.4.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-i18next": "^16.5.8",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.1",
		"utif": "3.1.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@eslint/js": "^9.38.0",
		"@tauri-apps/cli": "^2",
		"@types/node": "^25.5.0",
		"@types/papaparse": "5.5.2",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"eslint": "^9.38.0",
		"eslint-plugin-react-hooks": "^7.0.0",
		"globals": "^16.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.46.1",
		"vite": "^7.0.4"
	}
}
