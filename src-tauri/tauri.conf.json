{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "WingHarness",
	"mainBinaryName": "wingharness",
	"version": "0.0.6",
	"identifier": "com.anfioo.wingharness",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:11420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"plugins": {
		"updater": {
			"pubkey": "__TAURI_UPDATER_PUBKEY__",
			"endpoints": [
				"__TAURI_UPDATER_ENDPOINT__"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "WingHarness",
				"width": 800,
				"height": 600,
				"decorations": false,
				"transparent": true,
				"center": true,
				"shadow": false,
				"visible": true
			},
			{
				"label": "tray-menu",
				"url": "/tray-menu",
				"width": 220,
				"height": 160,
				"resizable": false,
				"center": false,
				"visible": false,
				"alwaysOnTop": true,
				"skipTaskbar": true,
				"decorations": false,
				"transparent": true,
				"shadow": false,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"windows": {
			"nsis": {
				"installerIcon": "icons/icon.ico",
				"languages": [
					"SimpChinese",
					"English"
				]
			}
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
