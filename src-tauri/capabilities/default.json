{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "about",
    "settings",

    "tray-menu"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-unminimize",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible",
    "core:window:allow-is-minimized",
    "core:window:allow-is-focused",
    "core:window:allow-is-maximized",
    "core:window:allow-is-always-on-top",
    "core:window:allow-set-always-on-top",
    "core:window:allow-destroy",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-scale-factor",
    "core:window:allow-set-position",
    "core:window:allow-center",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:webview:allow-create-webview-window",
    "core:webview:allow-webview-position",
    "core:webview:allow-webview-size",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "process:allow-restart",
    "updater:default",
    "updater:allow-check",
    "global-shortcut:default",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-register-all",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "allow-cancel-update-download",
    "allow-download-and-install-update",
    "allow-fonts-list",
    "allow-get-config",
    "allow-is-update-download-active",
    "allow-local-shell-kill",
    "allow-local-shell-list-fonts",
    "allow-local-shell-resize",
    "allow-local-shell-start",
    "allow-local-shell-write",
    "allow-notes-delete",
    "allow-notes-list",
    "allow-notes-mkdir",
    "allow-notes-rename",
    "allow-notes-write",
    "allow-open-devtools",
    "allow-preview-bytes",
    "allow-preview-metadata",
    "allow-project-delete",
    "allow-project-info",
    "allow-project-mkdir",
    "allow-project-move",
    "allow-project-read",
    "allow-project-tree",
    "allow-project-write",
    "allow-quit-app",
    "allow-save-config",
    "allow-set-data-dir",
    "allow-theme-fonts-css",
    "allow-update-tray-menu"
  ]
}
